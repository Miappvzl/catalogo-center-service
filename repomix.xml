                {/* 🚀 NUEVO: EL RESUMEN FINANCIERO SE MUEVE AL SCROLL */}
                {/* Ahora hace scroll natural con el contenido, liberando el 40% de la pantalla */}
                <div className="space-y-4 pt-8 border-t border-[var(--store-border)] mt-4 pb-8">
