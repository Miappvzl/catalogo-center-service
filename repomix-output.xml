                message += `🔸 ${item.quantity}x ${item.name} ${item.variantInfo ? `(${item.variantInfo})` : ""} ${priceText}\n`;
            });
            message += `\n*RESUMEN FINANCIERO:*\nSubtotal Base: $${cartEngine.totalListNominal.toFixed(2)}\n`;
