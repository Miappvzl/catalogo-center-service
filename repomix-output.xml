                <div className="space-y-4 pt-8 border-t border-[var(--store-border)] mt-4 pb-8">
                    <h2 className="text-[10px] font-black text-[var(--store-surface-text)] uppercase tracking-widest pb-2">Resumen de la Orden</h2>

