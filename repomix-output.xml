                    </AnimatePresence>

                    {/* 3. SELECTOR DE MÉTODOS (Clean Grid) */}
                    {(paymentMode === 'single' || remainingListUSD > 0.01) && (
                        <div className="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-4">
